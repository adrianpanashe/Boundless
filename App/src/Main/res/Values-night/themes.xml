<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Boundless" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <item name="colorPrimary">@color/deep_teal</item>
        <item name="colorPrimaryDark">@color/deep_teal_dark</item>
        <item name="colorAccent">@color/warm_orange</item>
        <item name="colorSecondary">@color/warm_orange</item>

        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnBackground">@color/white</item>

        <!-- Shape Appearance -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Boundless.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Boundless.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Boundless.Large</item>
    </style>

    <style name="RoundedBottomImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">32dp</item>
        <item name="cornerSizeBottomRight">32dp</item>
    </style>
</resources>